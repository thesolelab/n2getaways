# Deliberately disabled: rename and review only after editorial approval.
# A future weekly rebuild can release human-reviewed, date-gated Markdown.
name: Scheduled editorial rebuild
on:
  workflow_dispatch:
  # schedule:
  #   - cron: '0 12 * * 1'
permissions:
  contents: read
jobs:
  validate:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 24
          cache: npm
      - run: npm ci
      - run: npm run validate
# No content generation, commit, or deployment step is enabled.
