    "editorial:submit": "node scripts/editorial/cli.mjs submit",
    "editorial:sync": "node scripts/editorial/cli.mjs sync",
    "editorial:check": "node scripts/editorial/check.mjs",
    "editorial:test": "node --test editorial/tests/*.test.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.9",
    "@astrojs/sitemap": "^3.7.4",
    "@formspree/ajax": "^1.1.5",
    "astro": "^7.4.11"
