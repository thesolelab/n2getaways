---
import Base from "../layouts/Base.astro";
---

<Base
  title="Page not found"
  description="This page could not be found. Explore N2Getaways destinations and travel guides."
>
  <section class="section narrow page-intro">
    <p class="eyebrow">404 · A different route</p>
    <h1>Let’s find your way.</h1>
    <p>
      We couldn’t find that page. Browse the travel guides or head back to the
      homepage to continue exploring.
    </p>
    <div class="migration-links">
      <a class="button" href="/travel-guides/">
        Explore travel guides ↗
      </a>
      <a class="text-link" href="/">
        Back to the homepage ↗
      </a>
    </div>
  </section>
</Base>
