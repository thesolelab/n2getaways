---
import Base from "../layouts/Base.astro";
import SourceCopy from "../components/SourceCopy.astro";
import { isProduction } from "../config/site.mjs";
import { getSourcePage } from "../lib";
import { inquiryEndpoint, inquiryRecipient } from "../config/inquiry";
const page = await getSourcePage("/privacy-policy/");
---

<Base
  title={page.data.title}
  description="How N2Getaways handles inquiries, hosting and website data."
>
  <section class="section narrow page-intro">
    <p class="eyebrow">N2Getaways</p>
    <h1>Privacy information</h1>
    <section id="inquiry-privacy" class="inquiry-policy">
      <h2>Inquiries on this website</h2>
      {inquiryEndpoint ? (
        <>
          <p>
            When you submit an itinerary inquiry, your name, email address,
            destination and message are sent to Formspree for processing and
            delivery to {inquiryRecipient}. Formspree may store submissions and
            process technical information to operate the service and filter
            spam.
          </p>
          <p>
            We use the information you provide to respond to your inquiry.
            Please keep payment details, passport numbers and other sensitive
            information out of your message. Contact{" "}
            <a href={`mailto:${inquiryRecipient}`}>{inquiryRecipient}</a> with
            questions about your inquiry data. Read{" "}
            <a href="https://formspree.io/legal/privacy-policy/">
              Formspree’s privacy policy
            </a>{" "}
            for its processing and retention practices.
          </p>
        </>
      ) : (
        <p>
          Online form delivery is not yet active. The contact form and email
          link open your email app, and your message is handled by your chosen
          email provider. No inquiry is sent to Formspree in this mode.
        </p>
      )}
    </section>
    <section class="inquiry-policy">
      <h2>Hosting and website services</h2>
      <p>
        This website is hosted on Cloudflare Pages. Cloudflare processes
        technical request information to deliver and protect its services. Read{" "}
        <a href="https://www.cloudflare.com/privacypolicy/">
          Cloudflare’s privacy policy
        </a>{" "}
        for details.
      </p>
      <p>
        Fonts are loaded from Google Fonts, which creates requests to Google’s
        font service. Read{" "}
        <a href="https://policies.google.com/privacy">
          Google’s privacy policy
        </a>{" "}
        for its data practices.
      </p>
      <p>
        The current website does not include Google Analytics, advertising
        pixels, affiliate tracking scripts, or a newsletter signup. If these
        features are added, this information will be updated.
      </p>
      <h2>Questions and other websites</h2>
      <p>
        Links to other websites are subject to those websites’ own policies. For
        questions about information you provided in an inquiry, or to request
        access or deletion, contact{" "}
        <a href={`mailto:${inquiryRecipient}`}>{inquiryRecipient}</a>.
      </p>
    </section>
    {!isProduction && (
      <section class="inquiry-policy">
        <p class="notice">
          The current implementation is described above. The original WordPress
          policy below is preserved for comparison and contains claims about
          integrations that are not enabled on this preview.
        </p>
        <SourceCopy path="/privacy-policy/" collapsible />
      </section>
    )}
  </section>
</Base>
