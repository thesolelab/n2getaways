---
import Base from "../../layouts/Base.astro";
import DestinationTile from "../../components/DestinationTile.astro";
import SourceCopy from "../../components/SourceCopy.astro";
import { destinations, getSourcePage } from "../../lib";
const page = await getSourcePage("/destinations/");
---

<Base title={page.data.displayTitle} description={page.data.description}>
  <section class="section page-intro">
    <p class="eyebrow">Choose your next chapter</p>
    <h1>{page.data.displayTitle}</h1>
    <p>{page.data.description}</p>
    <div class="destination-grid" id="featured-destinations">
      {destinations.map((destination) => (
        <DestinationTile destination={destination} />
      ))}
    </div>
    <SourceCopy path="/destinations/" collapsible />
  </section>
</Base>
