---
import { isProduction } from "../../config/site.mjs";
import clusters from "../../config/clusters.json";
import { getImage } from "astro:assets";
import Base from "../../layouts/Base.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import SourceCopy from "../../components/SourceCopy.astro";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import {
  photos,
  destinations,
  sampleDestinations,
  getArticles,
} from "../../lib";
export async function getStaticPaths() {
  const pages = await getCollection("pages");
  return [...destinations, ...sampleDestinations].map((destination) => ({
    params: { slug: destination.slug },
    props: {
      destination,
      page: pages.find(
        (p) => p.data.permalink === `/destinations/${destination.slug}/`,
      ),
      sample: sampleDestinations.some((d) => d.slug === destination.slug),
    },
  }));
}
const { destination: d, page, sample } = Astro.props;
const articles = (await getArticles(sample)).filter(
  (a) => a.data.destination === d.name,
);
const imageKey = d.image as keyof typeof photos | undefined;
const cluster = clusters[d.slug as keyof typeof clusters];
const social = imageKey
  ? await getImage({
      src: photos[imageKey],
      width: 1200,
      height: 630,
      fit: "cover",
      format: "jpg",
    })
  : undefined;
const roles = [
  {
    id: "planning",
    name: "Plan your trip",
    description: "Practical guides to help make the main decisions.",
  },
  {
    id: "itineraries",
    name: "Itineraries",
    description: "Start with a trip outline, then adapt it to your interests.",
  },
  {
    id: "food",
    name: "Food & dining",
    description: "Food articles to explore alongside your travel plans.",
  },
  {
    id: "stays",
    name: "Where to stay",
    description: "Accommodation and location coverage from the archive.",
  },
  {
    id: "experiences",
    name: "Things to do",
    description: "Activities and sightseeing ideas to consider for your trip.",
  },
];
const groups = roles
  .map((r) => ({
    ...r,
    articles: articles.filter((a) => a.data.clusterRole === r.id),
  }))
  .filter((r) => r.articles.length);
const ungrouped = articles.filter((a) => !a.data.clusterRole);
---

<Base
  title={cluster?.title || page?.data.title || `${d.name} travel guides`}
  description={cluster?.description || page?.data.description || d.line}
  image={social?.src}
  imageAlt={cluster?.imageAlt || `${d.name} sample destination photograph`}
  imageWidth={social ? 1200 : undefined}
  imageHeight={social ? 630 : undefined}
  collectionItems={articles.map((article) => ({
    name: article.data.title,
    path: article.data.permalink,
  }))}
  breadcrumbs={[
    { name: "Home", path: "/" },
    { name: "Destinations", path: "/destinations/" },
    { name: d.name, path: Astro.url.pathname },
  ]}
>
  <section class:list={["destination-hero", { "destination-text": !imageKey }]}>
    {imageKey && (
      <Image
        src={photos[imageKey]}
        alt={cluster?.imageAlt || `${d.name} sample photograph`}
        width={Math.min(1000, photos[imageKey].width)}
        widths={[
          ...new Set(
            [400, 700, Math.min(1000, photos[imageKey].width)].filter(
              (w) => w <= photos[imageKey].width,
            ),
          ),
        ]}
        sizes="(max-width: 800px) calc(100vw - 32px), (max-width: 1440px) 60vw, 810px"
        loading="eager"
      />
    )}
    <div>
      <p class="eyebrow light">
        {d.region} ·{" "}
        {sample
          ? "Sample destination collection"
          : "From the N2Getaways archive"}
      </p>
      <h1>{d.name}</h1>
      <p>{d.line}</p>
    </div>
  </section>
  {d.slug === "maui" && (
    <p class="destination-photo-credit">
      Destination photograph:{" "}
      <a
        href="https://unsplash.com/photos/tropical-beach-at-sunset-in-maui-7782WXBriyM"
        target="_blank"
        rel="noopener noreferrer"
      >
        Ganapathy Kumar / Unsplash
      </a>{" "}
      · <a href="https://unsplash.com/license">Unsplash License</a>
    </p>
  )}
  <section class="section destination-hub">
    {!isProduction && (
      <p class="notice">
        {sample
          ? "Placeholder collection. These sample guides are separate from the imported WordPress archive."
          : "Migration review. Original articles are available below; some photography and travel details still need review."}
      </p>
    )}
    {cluster && (
      <div class="cluster-intro">
        <p class="eyebrow">{cluster.focus}</p>
        <h2>Start planning {d.name}</h2>
        <p>{cluster.intro}</p>
      </div>
    )}
    {groups.length > 0 && (
      <nav class="cluster-nav" aria-label={`${d.name} guide topics`}>
        {groups.map((g) => (
          <a href={`#${g.id}`}>{g.name}</a>
        ))}
      </nav>
    )}
    <div
      class:list={[
        "cluster-grid",
        {
          "cluster-grid--single": groups.length === 1,
          "cluster-grid--feature":
            groups.length === 1 && groups[0].articles.length === 1,
        },
      ]}
    >
      {groups.map((group) => (
        <section class="cluster-group" id={group.id}>
          <header class="cluster-group-heading">
            <h2>{group.name}</h2>
            <span>
              {group.articles.length}{" "}
              {group.articles.length === 1 ? "guide" : "guides"}
            </span>
          </header>
          <div class="cluster-articles">
            {group.articles.map((article) => (
              <ArticleCard article={article} />
            ))}
          </div>
        </section>
      ))}
    </div>
    {ungrouped.length > 0 && (
      <div class="article-grid">
        {ungrouped.map((article) => (
          <ArticleCard article={article} />
        ))}
      </div>
    )}
    {page && (
      <section class="destination-copy">
        <p class="eyebrow">Original destination guide</p>
        <SourceCopy path={page.data.permalink} />
      </section>
    )}
  </section>
</Base>
