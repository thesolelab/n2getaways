---
import Base from "../layouts/Base.astro";
---

<Base
  title="Plan your getaway"
  description="Contact N2Getaways about a custom itinerary."
>
  <section class="section narrow page-intro">
    <p class="eyebrow">Your trip, your way</p>
    <h1>
      Where are you
      <br />
      dreaming of?
    </h1>
    <p class="notice">
      This form opens a draft in your email app addressed to
      hello@n2getaways.com. Review and send it there. This website does not send
      or store your inquiry.
    </p>
    <p>
      Prefer to email directly?{" "}
      <a class="text-link" href="mailto:hello@n2getaways.com">
        hello@n2getaways.com
      </a>
    </p>
    <form id="inquiry">
      <label>
        Your name
        <input name="name" autocomplete="name" required />
      </label>
      <label>
        Email address
        <input name="email" type="email" autocomplete="email" required />
      </label>
      <label>
        Destination
        <input
          name="destination"
          required
          placeholder="Where would you like to go?"
        />
      </label>
      <label>
        Tell us about your trip
        <textarea
          name="details"
          rows="5"
          required
          placeholder="Dates, interests, and the kind of getaway you have in mind"
        ></textarea>
      </label>
      <button class="button" type="submit">
        Open inquiry in email app ↗
      </button>
      <p id="form-result" role="status"></p>
    </form>
  </section>
</Base>
<script>
  document
    .querySelector<HTMLFormElement>("#inquiry")
    ?.addEventListener("submit", (e) => {
      e.preventDefault();
      const form = e.currentTarget as HTMLFormElement;
      const fields = new FormData(form);
      const value = (key: string) => String(fields.get(key) || "").trim();
      const subject = `Custom itinerary inquiry: ${value("destination")}`;
      const body = `Name: ${value("name")}\nReply email: ${value("email")}\nDestination: ${value("destination")}\n\n${value("details")}`;
      window.location.href = `mailto:hello@n2getaways.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      const result = document.querySelector("#form-result");
      if (result)
        result.textContent =
          "Your email app should open with a draft. Please send it there. If nothing opens, email hello@n2getaways.com directly. Nothing has been sent by this website.";
    });
</script>
