---
import Base from "../layouts/Base.astro";
import SourceCopy from "../components/SourceCopy.astro";
import {
  inquiryRecipient,
  formspreeFormId,
  inquiryEndpoint,
} from "../config/inquiry";
const direct = Boolean(inquiryEndpoint);
---

<Base
  title="Contact N2Getaways & Custom Itinerary Inquiries"
  description="Contact N2Getaways with travel questions or a custom itinerary inquiry. Share your destination, trip dates, and interests to discuss your getaway plans."
>
  <section class="section narrow page-intro">
    <p class="eyebrow">Your trip, your way</p>
    <h1>
      Where are you
      <br />
      dreaming of?
    </h1>
    <p class="notice">
      {direct
        ? "Tell us where you want to go and what you have in mind. Submit your inquiry below and we’ll respond by email."
        : "This form opens a draft in your email app addressed to hello@n2getaways.com. Review and send it there. Online submissions will be available once delivery setup is complete."}
    </p>
    <p>
      Prefer to email directly?{" "}
      <a class="text-link" href={`mailto:${inquiryRecipient}`}>
        {inquiryRecipient}
      </a>
    </p>
    <form
      id="inquiry"
      action={inquiryEndpoint || `mailto:${inquiryRecipient}`}
      method="POST"
      enctype={direct ? "multipart/form-data" : "text/plain"}
      data-form-id={formspreeFormId}
      data-recipient={inquiryRecipient}
    >
      <label for="inquiry-name">
        Your name
        <input
          id="inquiry-name"
          name="name"
          autocomplete="name"
          minlength="2"
          maxlength="100"
          required
          data-fs-field
          aria-describedby="name-error"
        />
        <span id="name-error" class="field-error" data-fs-error="name"></span>
      </label>
      <label for="inquiry-email">
        Email address
        <input
          id="inquiry-email"
          name="email"
          type="email"
          autocomplete="email"
          maxlength="254"
          required
          data-fs-field
          aria-describedby="email-error"
        />
        <span id="email-error" class="field-error" data-fs-error="email"></span>
      </label>
      <label for="inquiry-destination">
        Destination
        <input
          id="inquiry-destination"
          name="destination"
          minlength="2"
          maxlength="160"
          placeholder="Where would you like to go?"
          required
          data-fs-field
          aria-describedby="destination-error"
        />
        <span
          id="destination-error"
          class="field-error"
          data-fs-error="destination"
        ></span>
      </label>
      <label for="inquiry-message">
        Tell us about your trip
        <textarea
          id="inquiry-message"
          name="message"
          rows="6"
          minlength="10"
          maxlength="5000"
          placeholder="Dates, interests, and the kind of getaway you have in mind"
          required
          data-fs-field
          aria-describedby="message-error"
        ></textarea>
        <span
          id="message-error"
          class="field-error"
          data-fs-error="message"
        ></span>
      </label>
      {direct && (
        <>
          <input
            type="hidden"
            name="_subject"
            value="N2Getaways itinerary inquiry"
          />
          <div class="inquiry-trap" aria-hidden="true">
            <label>
              Leave this empty
              <input
                type="text"
                name="_gotcha"
                tabindex="-1"
                autocomplete="off"
              />
            </label>
          </div>
          <p class="inquiry-privacy">
            We’ll use your name, email and trip details to respond to this
            inquiry. Your submission is processed by Formspree.{" "}
            <a href="/privacy-policy/#inquiry-privacy">Privacy information</a>.
          </p>
        </>
      )}
      <button class="button" type="submit" data-fs-submit-btn>
        {direct ? "Send inquiry ↗" : "Open inquiry in email app ↗"}
      </button>
      {direct && (
        <>
          <p
            class="form-feedback form-success"
            data-fs-success
            role="status"
            tabindex="-1"
          >
            Thank you—your inquiry was submitted successfully. We’ll respond by
            email.
          </p>
          <div
            class="form-feedback form-error"
            data-fs-error=""
            role="alert"
            tabindex="-1"
          >
            We couldn’t submit your inquiry. Your text is still here. Try again,
            complete any security check through the secure form page, or email{" "}
            <a href={`mailto:${inquiryRecipient}`}>{inquiryRecipient}</a>.
          </div>
          <button
            class="text-link provider-fallback"
            type="button"
            id="provider-fallback"
            hidden
          >
            Continue with secure form page ↗
          </button>
        </>
      )}
      <p id="form-result" role="status"></p>
    </form>
    <SourceCopy path="/contact/" collapsible />
  </section>
</Base>
<script>
  import { setupInquiry } from "../scripts/inquiry";
  const form = document.querySelector<HTMLFormElement>("#inquiry");
  if (form) setupInquiry(form);
</script>
