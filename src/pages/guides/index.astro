---
import Base from "../../layouts/Base.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import { getArticles } from "../../lib";
const articles = await getArticles();
---

<Base
  title="The travel journal"
  description="Explore travel guides, itinerary ideas, and the WordPress migration pilot."
>
  <section class="section page-intro">
    <p class="eyebrow">Ideas for the journey</p>
    <h1>The travel journal.</h1>
    <p>
      Original WordPress articles under migration review. Template samples are
      available separately.
    </p>
    <div class="article-grid">
      {articles.map((article) => (
        <ArticleCard article={article} />
      ))}
    </div>
  </section>
</Base>
