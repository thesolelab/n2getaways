---
import Base from "../layouts/Base.astro";
import { Image } from "astro:assets";
import { render } from "astro:content";
import { getArticles, photos } from "../lib";
export async function getStaticPaths() {
  return (await getArticles()).map((article) => ({
    params: { path: article.data.permalink.replace(/^\/|\/$/g, "") },
    props: { article },
  }));
}
const { article } = Astro.props;
const { data } = article;
const { Content, headings } = await render(article);
---

<Base
  title={data.title}
  description={data.description}
  image={data.image ? photos[data.image].src : undefined}
  article
>
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Article",
      headline: data.title,
      description: data.description,
      ...(data.image
        ? { image: new URL(photos[data.image].src, Astro.site).href }
        : {}),
      ...(!data.placeholder
        ? { datePublished: data.publishDate.toISOString() }
        : {}),
      mainEntityOfPage: new URL(data.permalink, Astro.site).href,
    })}
  />
  <article>
    <header class="article-heading">
      <a
        class="eyebrow"
        href={
          data.placeholder
            ? `/destinations/${data.destination.toLowerCase()}/`
            : "/migration-review/"
        }
      >
        {data.destination} / {data.category}
      </a>
      <h1>{data.title}</h1>
      <p>{data.description}</p>
      <div class="card-meta">
        {data.placeholder
          ? "Editorial placeholder"
          : "Imported from WordPress · Review copy"}{" "}
        · {data.readTime} min read
      </div>
    </header>
    {data.image && (
      <Image
        class="article-cover"
        src={photos[data.image]}
        alt={data.imageAlt}
        width={1600}
        widths={[800, 1200, 1600]}
        sizes="100vw"
        loading="eager"
      />
    )}
    <div class="article-body">
      <aside>
        <p class="eyebrow">In this guide</p>
        <nav aria-label="Table of contents">
          {headings
            .filter((h) => h.depth === 2)
            .map((h) => (
              <a href={`#${h.slug}`}>{h.text}</a>
            ))}
        </nav>
      </aside>
      <div class="prose">
        <p class="notice">
          {data.placeholder
            ? "Sample content — a template demonstration, not a published travel recommendation or account of personal experience."
            : "Migration review — original WordPress article text. Photography is pending transfer; travel details have not been reverified."}
        </p>
        <Content />
        <a
          class="text-link"
          href={
            data.placeholder
              ? `/destinations/${data.destination.toLowerCase()}/`
              : "/migration-review/"
          }
        >
          {data.placeholder
            ? `More from ${data.destination}`
            : "Back to migration review"}{" "}
          ↗
        </a>
      </div>
    </div>
  </article>
</Base>
