---
import Base from "../layouts/Base.astro";
import ArticleCard from "../components/ArticleCard.astro";
import DestinationTile from "../components/DestinationTile.astro";
import { isProduction } from "../config/site.mjs";
import SourceCopy from "../components/SourceCopy.astro";
import { Image } from "astro:assets";
import { photos, destinations, getArticles } from "../lib";
const articles = await getArticles();
---

<Base
  title="Travel Guides, Weekend Getaways & Itineraries"
  description="Plan your next getaway with destination guides, weekend itineraries, food articles, and travel planning resources from the N2Getaways publication."
>
  <section class="hero">
    <Image
      class="hero-image"
      src={photos.asheville}
      alt="Boston Way street sign and autumn trees in Biltmore Village"
      widths={[600, 1024]}
      sizes="100vw"
      width={1024}
      loading="eager"
      fetchpriority="high"
    />
    <div class="hero-shade"></div>
    <div class="hero-copy">
      <p class="eyebrow light">A little curiosity. A world of possibility.</p>
      <h1>
        Go somewhere.
        <br />
        <em>Feel something.</em>
      </h1>
      <p>
        Thoughtful guides. Unforgettable places.
        <br />
        Find the inspiration for your next great getaway.
      </p>
      <a class="button cream" href="/destinations/">
        Find your next destination <span>↗</span>
      </a>
    </div>
    <div class="hero-caption">
      <span>THE VIEW FROM HERE</span>
      <b>Biltmore Village, Asheville</b>
      <small>From the N2Getaways archive</small>
    </div>
    <span class="hero-index">THE JOURNEY STARTS HERE</span>
  </section>
  <section class="intro-strip">
    <span class="eyebrow">Less ordinary. More discovery.</span>
    <p>
      For the big adventures.
      <br />
      And the little moments in between.
    </p>
    <a href="/about/" class="text-link">
      Meet N2Getaways ↗
    </a>
  </section>
  <section class="section">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Where will curiosity take you?</p>
        <h2>A world worth exploring.</h2>
      </div>
      <a class="text-link" href="/destinations/">
        All destinations ↗
      </a>
    </div>
    <div class="destination-grid">
      {destinations.slice(0, 3).map((destination) => (
        <DestinationTile destination={destination} />
      ))}
    </div>
  </section>
  <section class="section journal">
    <div class="section-heading">
      <div>
        <p class="eyebrow">The travel journal</p>
        <h2>A little inspiration goes a long way.</h2>
      </div>
      <a class="text-link" href="/travel-guides/">
        Browse the journal ↗
      </a>
    </div>
    <div class="article-grid">
      {articles.slice(0, 3).map((article) => (
        <ArticleCard article={article} />
      ))}
    </div>
  </section>
  <section class="planning">
    <div class="planning-symbol">✳</div>
    <div>
      <p class="eyebrow light">Your trip, your way</p>
      <h2>
        Great getaways start
        <br />
        with a little imagination.
      </h2>
      <p>
        Have a destination in mind? Start an itinerary inquiry and start shaping
        your next adventure.
      </p>
      <a class="button cream" href="/contact/">
        Let’s plan something memorable <span>↗</span>
      </a>
    </div>
    <div class="planning-note">
      Take the scenic route.
      <br />
      <em>It’s worth it.</em>
    </div>
  </section>
  {!isProduction && (
    <section class="section">
      <SourceCopy path="/" collapsible />
    </section>
  )}
</Base>
