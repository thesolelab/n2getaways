---
import Base from "../../layouts/Base.astro";
import MediaFile from "../../components/MediaFile.astro";
import media from "../../../docs/migration/missing-media.json";
const priority = media.filter((m) => m.articlePhoto && !m.external);
const secondary = media.filter((m) => !m.articlePhoto && !m.external);
const external = media.filter((m) => m.external);
const batches = Array.from({ length: Math.ceil(priority.length / 5) }, (_, i) =>
  priority.slice(i * 5, (i + 1) * 5),
);
---

<Base
  title="Photo transfer checklist"
  description="Exact WordPress photo filenames for small migration batches."
>
  <section class="media-checklist page-intro">
    <p class="eyebrow">Migration review</p>
    <h1>Bring the photos along.</h1>
    <p>
      The two pilot photos are already restored. This checklist covers the
      remaining {priority.length} article image files, followed by{" "}
      {secondary.length} files referenced only by the old page layouts.
    </p>
    <p class="notice">
      Download only the listed files from SiteGround's{" "}
      <code>public_html/wp-content/uploads</code> folder. ZIP about five files
      at a time and keep each ZIP below 32 MB. Leave the originals in place. If
      a filename is unavailable, keep it on the checklist rather than
      substituting an unrelated photo.
    </p>
    <p class="media-copy-status" role="status" aria-live="polite"></p>
    {batches.map((batch, index) => (
      <section class="media-batch">
        <h2>
          Batch {index + 1} · {batch.length} files
        </h2>
        <ul class="media-file-list">
          {batch.map((item) => (
            <MediaFile item={item} />
          ))}
        </ul>
      </section>
    ))}
    {external.length > 0 && (
      <section class="media-batch">
        <h2>Externally hosted article images</h2>
        <p>
          {external.length} image references point to an external image service
          rather than WordPress uploads. They are excluded from the SiteGround
          file batches. Original files or reviewed replacements will be needed.
        </p>
        <ul>
          {external.map((item) => (
            <li>
              {item.usedBy.map((path) => (
                <a class="text-link" href={path}>
                  {path}
                </a>
              ))}
            </li>
          ))}
        </ul>
      </section>
    )}
    <details class="source-copy">
      <summary>Lower-priority images from original page layouts</summary>
      <p>
        Some are old thumbnails or theme images. Review their relevance and
        licensing before transferring them.
      </p>
      <ul class="media-file-list">
        {secondary.map((item) => (
          <MediaFile item={item} />
        ))}
      </ul>
    </details>
    <p class="destination-copy">
      <a class="text-link" href="/migration-review/">
        Back to migration review ↗
      </a>
    </p>
  </section>
</Base>

<script>
  document
    .querySelectorAll<HTMLButtonElement>("[data-copy-filename]")
    .forEach((button) => {
      button.addEventListener("click", async () => {
        const status = document.querySelector(".media-copy-status");
        try {
          if (!navigator.clipboard) throw new Error("Clipboard unavailable");
          await navigator.clipboard.writeText(
            button.dataset.copyFilename || "",
          );
          button.textContent = "Copied";
          if (status) status.textContent = "Filename copied.";
          setTimeout(() => {
            button.textContent = "Copy filename";
          }, 2000);
        } catch {
          const input = button
            .closest(".media-file")
            ?.querySelector<HTMLInputElement>("input");
          input?.focus();
          input?.select();
          if (status)
            status.textContent =
              "Filename selected. Use your device’s Copy command.";
        }
      });
    });
</script>
