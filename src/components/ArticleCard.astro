---
import { Image } from "astro:assets";
import { photos } from "../lib";
import type { CollectionEntry } from "astro:content";
interface Props {
  article: CollectionEntry<"articles">;
}
const { data } = Astro.props.article;
---

<article class="article-card">
  <a href={data.permalink}>
    <div class="card-photo">
      {data.image ? (
        <Image
          src={photos[data.image]}
          alt={data.imageAlt}
          widths={[400, 700, 1000]}
          sizes="(max-width:700px) 100vw, 33vw"
          width={700}
        />
      ) : (
        <div class="text-cover">
          <span>From the N2Getaways archive</span>
          <b>{data.destination}</b>
          <small>Original photography pending</small>
        </div>
      )}
      <span>{data.category}</span>
    </div>
    <div class="card-meta">
      {data.destination}{" "}
      <span>
        · {data.readTime} min read ·{" "}
        {data.placeholder ? "Sample" : "Migration review"}
      </span>
    </div>
    <h3>{data.title}</h3>
    <p>{data.description}</p>
    <span class="text-link">
      Explore the guide <span>↗</span>
    </span>
  </a>
</article>
