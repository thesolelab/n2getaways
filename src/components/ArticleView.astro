---
import type { CollectionEntry } from "astro:content";
import { isProduction } from "../config/site.mjs";
import Base from "../layouts/Base.astro";
import { Image, getImage } from "astro:assets";
import { render } from "astro:content";
import { photos, destinationPath, getArticles } from "../lib";
interface Props {
  article: CollectionEntry<"articles">;
}
const { article } = Astro.props;
const { data } = article;
const coverWidth = data.image ? photos[data.image].width : 1600;
const { Content, headings } = await render(article);
const social = data.image
  ? await getImage({
      src: photos[data.image],
      width: 1200,
      height: 630,
      fit: data.imageDisplay === "full" ? "contain" : "cover",
      format: "jpg",
    })
  : undefined;
const researchFiles = import.meta.glob<{
  default: { sources: { url: string }[] };
}>("../../editorial/research/*.json", { eager: true });
const sources = data.editorialTopicId
  ? researchFiles[
      `../../editorial/research/${data.editorialTopicId}.json`
    ]?.default.sources.map((s) => s.url)
  : undefined;
const crumbs = [
  { name: "Home", path: "/" },
  { name: data.destination, path: destinationPath(data.destination) },
  { name: data.title, path: Astro.url.pathname },
];
const related = (await getArticles())
  .filter(
    (a) =>
      a.data.destination === data.destination &&
      a.data.permalink !== data.permalink,
  )
  .slice(0, 3);
---

<Base
  title={data.seoTitle ?? data.title}
  description={data.description}
  image={social?.src}
  imageAlt={data.imageAlt}
  imageWidth={social ? 1200 : undefined}
  imageHeight={social ? 630 : undefined}
  breadcrumbs={crumbs}
  articleMetadata={{
    headline: data.title,
    destination: data.destination,
    category: data.category,
    publishDate: data.publishDate,
    updatedDate: data.updatedDate,
    draft: data.draft,
    placeholder: data.placeholder,
    publicationByline: Boolean(data.editorialTopicId),
    sources,
  }}
  article
>
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href="/">Home</a>
    <span aria-hidden="true">/</span>
    <a href={destinationPath(data.destination)}>{data.destination}</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">{data.title}</span>
  </nav>
  <article data-editorial-topic={data.editorialTopicId}>
    {data.draft && (
      <p class="notice">
        Unpublished editorial draft — requires owner approval. Research and
        claims still need editorial verification.
      </p>
    )}
    <header class="article-heading">
      <a class="eyebrow" href={destinationPath(data.destination)}>
        {data.destination} / {data.category}
      </a>
      <h1>{data.title}</h1>
      <p>{data.description}</p>
      {data.editorialTopicId && (
        <p class="article-byline">
          By <a href="/about/">N2Getaways</a>
        </p>
      )}
      {data.updatedDate && !data.draft && (
        <p>
          Updated{" "}
          <time datetime={data.updatedDate.toISOString()}>
            {data.updatedDate.toLocaleDateString("en-US", {
              timeZone: "UTC",
              year: "numeric",
              month: "long",
              day: "numeric",
            })}
          </time>
        </p>
      )}
      <div class="card-meta">
        {data.placeholder
          ? "Editorial placeholder · "
          : data.editorialTopicId
            ? data.draft
              ? "Unpublished editorial draft · "
              : ""
            : !isProduction
              ? "Imported from WordPress · Review copy · "
              : ""}
        {data.readTime} min read
      </div>
      {!data.placeholder && !data.draft && (
        <p class="archive-notice">
          {data.editorialTopicId ? "Published" : "Originally published"}{" "}
          <time datetime={data.publishDate.toISOString()}>
            {data.publishDate.toLocaleDateString("en-US", {
              year: "numeric",
              month: "long",
              day: "numeric",
              timeZone: "UTC",
            })}
          </time>{" "}
          {!isProduction &&
            !data.editorialTopicId &&
            " · Imported archive copy"}
        </p>
      )}
    </header>
    {data.image && (
      <Image
        class:list={[
          "article-cover",
          { "article-cover-full": data.imageDisplay === "full" },
        ]}
        src={photos[data.image]}
        alt={data.imageAlt}
        width={Math.min(1600, coverWidth)}
        widths={[800, 1200, 1600].filter((width) => width <= coverWidth)}
        sizes="100vw"
        loading="eager"
      />
    )}
    <div class="article-body">
      <aside>
        <p class="eyebrow">In this guide</p>
        <nav aria-label="Table of contents">
          {headings
            .filter((h) => h.depth >= 2 && h.depth <= 3)
            .map((h) => (
              <a href={`#${h.slug}`}>{h.text}</a>
            ))}
        </nav>
      </aside>
      <div class="prose">
        {!isProduction && !data.editorialTopicId && (
          <p class="notice">
            {data.placeholder
              ? "Sample content — a template demonstration, not a published travel recommendation or account of personal experience."
              : data.image
                ? "Migration review — original WordPress article text and supplied photography. Travel details have not been reverified."
                : "Migration review — original WordPress article text. Photography is pending transfer; travel details have not been reverified."}
          </p>
        )}
        {data.reviewNotes
          .filter((note) => !isProduction || !note.startsWith("Pilot review"))
          .map((note) => (
            <p class="notice">
              {isProduction && note.startsWith("Time-sensitive") ? (
                <>
                  Airport security conditions may have changed since this
                  article was published. Check current{" "}
                  <a href="https://www.tsa.gov/">TSA</a> and airport information
                  before travel.
                </>
              ) : (
                note
              )}
            </p>
          ))}
        <div data-migrated-body>
          <Content />
        </div>
        <a class="text-link" href={destinationPath(data.destination)}>
          {data.placeholder
            ? `More from ${data.destination}`
            : `More from ${data.destination}`}{" "}
          ↗
        </a>
      </div>
    </div>
    {related.length > 0 && (
      <section class="related-reading">
        <h2>Continue planning {data.destination}</h2>
        <ul>
          {related.map((a) => (
            <li>
              <a href={a.data.permalink}>{a.data.title}</a>
            </li>
          ))}
        </ul>
        <a class="text-link" href={destinationPath(data.destination)}>
          All {data.destination} guides ↗
        </a>
      </section>
    )}
  </article>
</Base>
