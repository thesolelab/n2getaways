---
import "../styles/global.css";
import { isProduction, isReviewPath } from "../config/site.mjs";
interface Props {
  title: string;
  description: string;
  image?: string;
  article?: boolean;
}
const {
  title,
  description,
  image = "/social.jpg",
  article = false,
} = Astro.props;
const noindex = !isProduction || isReviewPath(Astro.url.pathname);
const canonical = new URL(Astro.url.pathname, Astro.site);
const social = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title} | N2Getaways</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta
      name="robots"
      content={noindex ? "noindex, nofollow" : "index, follow"}
    />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:image" content={social} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#1D383B" />
    <link rel="icon" href="/favicon.svg" />
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "WebSite",
        name: "N2Getaways",
        url: Astro.site,
      })}
    />
  </head>
  <body>
    <a class="skip" href="#main">
      Skip to content
    </a>
    {!isProduction && (
      <div class="preview-note">
        A new chapter for N2Getaways{" "}
        <span>· Development preview — WordPress content under review</span>
      </div>
    )}
    <header class="header">
      <a class="wordmark" href="/" aria-label="N2Getaways home">
        N2<span>Getaways</span>
        <i>✳</i>
      </a>
      <nav aria-label="Main navigation">
        <a
          href="/destinations/"
          aria-current={
            Astro.url.pathname.startsWith("/destinations") ? "page" : undefined
          }
        >
          Destinations
        </a>
        <a
          href="/travel-guides/"
          aria-current={
            Astro.url.pathname.startsWith("/travel-guides") ? "page" : undefined
          }
        >
          Travel journal
        </a>
        <a href="/about/">Our story</a>
      </nav>
      <a class="plan-link" href="/contact/">
        Plan your getaway <span>↗</span>
      </a>
      <details class="mobile-nav">
        <summary aria-label="Open navigation">Menu ☰</summary>
        <nav aria-label="Mobile navigation">
          <a href="/destinations/">Destinations</a>
          <a href="/travel-guides/">Travel journal</a>
          <a href="/about/">Our story</a>
          <a href="/contact/">Plan your getaway</a>
        </nav>
      </details>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer>
      <div>
        <a class="wordmark" href="/">
          N2<span>Getaways</span>
          <i>✳</i>
        </a>
        <p>For the places that stay with you.</p>
      </div>
      <div class="footer-links">
        <a href="/destinations/">Explore destinations</a>
        <a href="/about/">About N2Getaways</a>
        <a href="/contact/">Get in touch</a>
        <a href="/privacy-policy/">Privacy</a>
      </div>
      <div class="footer-bottom">
        <span>© {new Date().getFullYear()} N2Getaways</span>
        {!isProduction && (
          <span>Private migration preview · Content awaiting review</span>
        )}
      </div>
    </footer>
  </body>
</html>
