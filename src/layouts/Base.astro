---
import "../styles/global.css";
import { getImage } from "astro:assets";
import defaultPhoto from "../assets/asheville.jpg";
import {
  structuredGraph,
  jsonLD,
  type ArticleMetadata,
  type Breadcrumb,
} from "../seo";
import { isProduction, isReviewPath } from "../config/site.mjs";
interface Props {
  title: string;
  description: string;
  image?: string;
  article?: boolean;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  articleMetadata?: ArticleMetadata;
  breadcrumbs?: Breadcrumb[];
  collectionItems?: Breadcrumb[];
}
const {
  title,
  description,
  image,
  imageAlt = "Autumn street scene in Biltmore Village, Asheville",
  imageWidth,
  imageHeight,
  articleMetadata,
  breadcrumbs = [],
  collectionItems = [],
  article = false,
} = Astro.props;
const noindex = !isProduction || isReviewPath(Astro.url.pathname);
const canonical = new URL(Astro.url.pathname, Astro.site);
const fallback = !image
  ? await getImage({
      src: defaultPhoto,
      width: 1200,
      height: 630,
      fit: "cover",
      format: "jpg",
    })
  : undefined;
const social = new URL(image ?? fallback!.src, Astro.site);
const socialAlt =
  imageAlt || "Autumn street scene in Biltmore Village, Asheville";
const socialWidth = imageWidth ?? (fallback ? 1200 : undefined);
const socialHeight = imageHeight ?? (fallback ? 630 : undefined);
const graph = structuredGraph({
  origin: Astro.site!.href,
  path: Astro.url.pathname,
  title,
  description,
  image: {
    src: social.href,
    alt: socialAlt,
    width: socialWidth,
    height: socialHeight,
  },
  article: articleMetadata,
  breadcrumbs,
  collectionItems,
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title} | N2Getaways</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta
      name="robots"
      content={noindex ? "noindex, nofollow" : "index, follow"}
    />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:image" content={social} />
    <meta property="og:site_name" content="N2Getaways" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image:alt" content={socialAlt} />
    {socialWidth && (
      <meta property="og:image:width" content={String(socialWidth)} />
    )}
    {socialHeight && (
      <meta property="og:image:height" content={String(socialHeight)} />
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={social} />
    <meta name="twitter:image:alt" content={socialAlt} />
    {articleMetadata &&
      !articleMetadata.draft &&
      !articleMetadata.placeholder && (
        <meta
          property="article:published_time"
          content={articleMetadata.publishDate?.toISOString()}
        />
      )}
    {articleMetadata?.updatedDate &&
      !articleMetadata.draft &&
      !articleMetadata.placeholder && (
        <meta
          property="article:modified_time"
          content={articleMetadata.updatedDate.toISOString()}
        />
      )}
    {articleMetadata && (
      <meta property="article:section" content={articleMetadata.category} />
    )}
    <meta name="theme-color" content="#1D383B" />
    <link rel="icon" href="/favicon.svg" />
    <script type="application/ld+json" set:html={jsonLD(graph)} />
  </head>
  <body>
    <a class="skip" href="#main">
      Skip to content
    </a>
    {!isProduction && (
      <div class="preview-note">
        A new chapter for N2Getaways{" "}
        <span>· Development preview — WordPress content under review</span>
      </div>
    )}
    <header class="header">
      <a class="wordmark" href="/" aria-label="N2Getaways home">
        N2<span>Getaways</span>
        <i>✳</i>
      </a>
      <nav aria-label="Main navigation">
        <a
          href="/destinations/"
          aria-current={
            Astro.url.pathname.startsWith("/destinations") ? "page" : undefined
          }
        >
          Destinations
        </a>
        <a
          href="/travel-guides/"
          aria-current={
            Astro.url.pathname.startsWith("/travel-guides") ? "page" : undefined
          }
        >
          Travel journal
        </a>
        <a href="/about/">Our story</a>
      </nav>
      <a class="plan-link" href="/contact/">
        Plan your getaway <span>↗</span>
      </a>
      <details class="mobile-nav">
        <summary aria-label="Open navigation">Menu ☰</summary>
        <nav aria-label="Mobile navigation">
          <a href="/destinations/">Destinations</a>
          <a href="/travel-guides/">Travel journal</a>
          <a href="/about/">Our story</a>
          <a href="/contact/">Plan your getaway</a>
        </nav>
      </details>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer>
      <div>
        <a class="wordmark" href="/">
          N2<span>Getaways</span>
          <i>✳</i>
        </a>
        <p>For the places that stay with you.</p>
      </div>
      <div class="footer-links">
        <a href="/destinations/">Explore destinations</a>
        <a href="/about/">About N2Getaways</a>
        <a href="/contact/">Get in touch</a>
        <a href="/privacy-policy/">Privacy</a>
      </div>
      <div class="footer-bottom">
        <span>© {new Date().getFullYear()} N2Getaways</span>
        {!isProduction && (
          <span>Private migration preview · Content awaiting review</span>
        )}
      </div>
    </footer>
  </body>
</html>
